FROM python:3.12-slim
WORKDIR /app
COPY requirements-core.txt .
RUN pip install --no-cache-dir -r requirements-core.txt
COPY iot_shared ./iot_shared
COPY contracts ./contracts
COPY projects/traffic-light ./projects/traffic-light
RUN useradd --create-home iot
USER iot
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "app.main:app", "--app-dir", "projects/traffic-light", "--host", "0.0.0.0", "--port", "8000"]
