FROM python:3.12-slim
WORKDIR /app
ENV PYTHONPATH=/app:/app/platform/registry:/app/platform/ingestion
COPY requirements-core.txt requirements-registry.txt requirements-platform.txt requirements-dev-lock.txt ./
RUN pip install --no-cache-dir -c requirements-dev-lock.txt -r requirements-platform.txt
COPY platform ./platform
COPY iot_shared ./iot_shared
COPY contracts ./contracts
RUN useradd --create-home iot
USER iot
CMD ["python", "-m", "uvicorn", "ingestion_service.api:app", "--host", "0.0.0.0", "--port", "8002"]
