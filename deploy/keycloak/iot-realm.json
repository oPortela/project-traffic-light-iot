{
  "realm": "iot", "enabled": true, "sslRequired": "external",
  "registrationAllowed": false, "resetPasswordAllowed": false,
  "bruteForceProtected": true, "accessTokenLifespan": 300,
  "roles": {"realm": [{"name":"administrador"},{"name":"gestor"},{"name":"operador"},{"name":"integrador"},{"name":"leitor"}]},
  "clients": [{
    "clientId":"iot-portal", "enabled":true, "publicClient":true,
    "standardFlowEnabled":true, "directAccessGrantsEnabled":false,
    "redirectUris":["https://portal.localhost:8443/*"], "webOrigins":["https://portal.localhost:8443"],
    "attributes":{"pkce.code.challenge.method":"S256"},
    "protocolMappers":[
      {"name":"tenant","protocol":"openid-connect","protocolMapper":"oidc-usermodel-attribute-mapper",
       "config":{"user.attribute":"inquilino","claim.name":"inquilino","jsonType.label":"String","access.token.claim":"true","id.token.claim":"true"}},
      {"name":"api-audience","protocol":"openid-connect","protocolMapper":"oidc-audience-mapper",
       "config":{"included.custom.audience":"iot-api","access.token.claim":"true","id.token.claim":"false"}}
    ]
  }],
  "browserFlow":"iot-mfa",
  "authenticationFlows":[{
    "alias":"iot-mfa","description":"Password and TOTP required for every platform user",
    "providerId":"basic-flow","topLevel":true,"builtIn":false,
    "authenticationExecutions":[
      {"authenticator":"auth-username-password-form","requirement":"REQUIRED","priority":10,"authenticatorFlow":false},
      {"authenticator":"auth-otp-form","requirement":"REQUIRED","priority":20,"authenticatorFlow":false}
    ]
  }],
  "requiredActions":[{"alias":"CONFIGURE_TOTP","name":"Configure OTP","providerId":"CONFIGURE_TOTP","enabled":true,"defaultAction":true,"priority":10}]
}
