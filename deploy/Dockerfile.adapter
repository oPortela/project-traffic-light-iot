FROM python:3.12-slim
WORKDIR /app
ENV PYTHONPATH=/app
COPY requirements-core.txt requirements-dev-lock.txt ./
RUN pip install --no-cache-dir -c requirements-dev-lock.txt -r requirements-core.txt
COPY iot_shared ./iot_shared
COPY contracts ./contracts
COPY projects/legacy-adapter ./adapter
RUN useradd --create-home iot
USER iot
CMD ["python", "adapter/adapter.py"]
